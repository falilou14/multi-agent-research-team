# Copier en .env (jamais commité -- voir .gitignore) et remplir les vraies valeurs.

GEMINI_API_KEY=
# Optionnel. Si 503 "high demand" sur le palier gratuit : gemini-flash-lite-latest.
GEMINI_MODEL=gemini-flash-latest

# Moteur de recherche : ddgs (DuckDuckGo, gratuit, sans clé) ou tavily (clé requise).
SEARCH_BACKEND=ddgs
TAVILY_API_KEY=

# Observabilité LangSmith (optionnel -- absent = pas de tracing, pas d'erreur).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research-team
